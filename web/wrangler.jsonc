// The account-specific values are filled in at deployment. None of these are secrets.
{
  "name": "apikeybin",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  // A second origin for the same code would be a second thing to protect.
  "workers_dev": false,
  "routes": [{ "pattern": "app.apikeybin.com", "custom_domain": true }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/embed", "/open", "/api/*", "/s/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "apikeybin", "database_id": "00000000-0000-0000-0000-000000000000" }
  ],
  "ratelimits": [
    { "name": "RL_CREATE", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_OPEN", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ],
  // The one origin allowed to put /embed in a frame.
  "vars": { "SITE_ORIGIN": "https://apikeybin.com" },
  // Logs would be a record of who opened what and when. Nothing here needs one.
  "observability": { "enabled": false },
  "triggers": { "crons": ["*/30 * * * *"] }
}
